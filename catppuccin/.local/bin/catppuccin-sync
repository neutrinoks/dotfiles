#!/usr/bin/env python3
"""Keep Claude Code's Catppuccin theme in step with the system's light/dark setting.

On every switch it writes, for each Claude Code config dir (~/.claude and any other ~/.claude*
dir with a settings.json):

  themes/catppuccin.json       for Claude Code in a terminal (background: Catppuccin base)
  themes/catppuccin-nvim.json  for Claude Code inside NeoVim's float (dark: lifted background)

Light is Latte, dark is Frappé. Claude Code watches its themes/ folder and re-renders running
sessions on change. settings.json is kept on "custom:catppuccin"; NeoVim starts Claude Code with
--settings selecting "custom:catppuccin-nvim" instead.

Linux (GNOME) follows the XDG desktop portal's color-scheme event; macOS polls the appearance
setting. `install` also gives GNOME Console a Catppuccin livery (Latte by day, Frappé by night),
so the terminal background matches the theme.

Usage: catppuccin-sync [watch | apply | install | uninstall]
  watch      apply now, then follow every switch (default; what the service runs)
  apply      apply once for the current setting and exit
  install    set up the user service (systemd on Linux, launchd on macOS) and, on GNOME,
             the Console livery
  uninstall  remove the service and the Console livery
"""

import json
import math
import os
import re
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
CLAUDE_THEME = "custom:catppuccin"
TERMINAL_SLUG = "catppuccin"
NVIM_SLUG = "catppuccin-nvim"
# Background of NeoVim's Claude float in dark mode: ClaudeTermNormal in nvim's catppuccin.lua.
# Keep both in step.
NVIM_FLOAT_BG_DARK = "#3d4157"

SERVICE_NAME = "catppuccin-sync"
LAUNCHD_LABEL = "local.catppuccin-sync"
MAC_POLL_SECONDS = 2

# GNOME Console livery; the UUID identifies it in org.gnome.Console custom-liveries.
LIVERY_UUID = "f7aa57a5-a22b-4eeb-9c83-7771ae676875"
LIVERY_NAME = "Catppuccin"

PALETTES = {
    "latte": {
        "rosewater": "#dc8a78", "flamingo": "#dd7878", "pink": "#ea76cb", "mauve": "#8839ef",
        "red": "#d20f39", "maroon": "#e64553", "peach": "#fe640b", "yellow": "#df8e1d",
        "green": "#40a02b", "teal": "#179299", "sky": "#04a5e5", "sapphire": "#209fb5",
        "blue": "#1e66f5", "lavender": "#7287fd", "text": "#4c4f69", "subtext1": "#5c5f77",
        "subtext0": "#6c6f85", "overlay2": "#7c7f93", "overlay1": "#8c8fa1",
        "overlay0": "#9ca0b0", "surface2": "#acb0be", "surface1": "#bcc0cc",
        "surface0": "#ccd0da", "base": "#eff1f5", "mantle": "#e6e9ef", "crust": "#dce0e8",
    },
    "frappe": {
        "rosewater": "#f2d5cf", "flamingo": "#eebebe", "pink": "#f4b8e4", "mauve": "#ca9ee6",
        "red": "#e78284", "maroon": "#ea999c", "peach": "#ef9f76", "yellow": "#e5c890",
        "green": "#a6d189", "teal": "#81c8be", "sky": "#99d1db", "sapphire": "#85c1dc",
        "blue": "#8caaee", "lavender": "#babbf1", "text": "#c6d0f5", "subtext1": "#b5bfe2",
        "subtext0": "#a5adce", "overlay2": "#949cbb", "overlay1": "#838ba7",
        "overlay0": "#737994", "surface2": "#626880", "surface1": "#51576d",
        "surface0": "#414559", "base": "#303446", "mantle": "#292c3c", "crust": "#232634",
    },
}

# ANSI 0-15 for the Console livery. Frappé matches NeoVim's :terminal palette (catppuccin.lua);
# Latte follows Catppuccin's terminal ports.
ANSI = {
    "frappe": ["surface1", "red", "green", "yellow", "blue", "pink", "teal", "subtext1",
               "surface2", "red", "green", "yellow", "blue", "pink", "teal", "text"],
    "latte": ["subtext1", "red", "green", "yellow", "blue", "pink", "teal", "surface2",
              "subtext0", "red", "green", "yellow", "blue", "pink", "teal", "surface1"],
}


def log(message):
    print(f"catppuccin-sync: {message}", file=sys.stderr, flush=True)


def hex_to_rgb(color):
    return [int(color[i:i + 2], 16) for i in (1, 3, 5)]


def blend(fg, bg, alpha):
    """Same result as catppuccin.utils.colors.blend in the NeoVim plugin."""
    def channel(f, b):
        return math.floor(min(max(0, alpha * f + (1 - alpha) * b), 255) + 0.5)
    return "#%02X%02X%02X" % tuple(channel(f, b) for f, b in zip(hex_to_rgb(fg), hex_to_rgb(bg)))


def claude_theme(name, flavour, bg=None, lifted=False):
    """Claude's own preset as base, Catppuccin on top.

    `bg` is the background Claude is drawn on (None = Catppuccin base); `lifted` moves message
    surfaces one step up so they stay visible on a background lighter than base.
    """
    p = PALETTES[flavour]
    bg = bg or p["base"]
    s0, s1, s2 = p["surface0"], p["surface1"], p["surface2"]
    if lifted:
        s0, s1, s2 = p["surface1"], p["surface2"], p["surface2"]
    return {
        "name": name,
        "base": "light" if flavour == "latte" else "dark",
        "overrides": {
            "claude": p["peach"],
            "claudeShimmer": p["rosewater"],
            "text": p["text"],
            "inverseText": p["base"],
            "inactive": p["overlay1"],
            "inactiveShimmer": p["overlay2"],
            "subtle": p["surface2"],
            "suggestion": p["blue"],
            "permission": p["lavender"],
            "permissionShimmer": p["blue"],
            "remember": p["sapphire"],
            "success": p["green"],
            "error": p["red"],
            "warning": p["yellow"],
            "warningShimmer": p["peach"],
            "merged": p["mauve"],
            "promptBorder": p["overlay0"],
            "promptBorderShimmer": p["overlay1"],
            "planMode": p["teal"],
            "autoAccept": p["mauve"],
            "bashBorder": p["pink"],
            "ide": p["blue"],
            # Blend strengths keep the text colour at ~4:1 or better on every diff background.
            "diffAdded": blend(p["green"], bg, 0.18),
            "diffRemoved": blend(p["red"], bg, 0.18),
            "diffAddedDimmed": blend(p["green"], bg, 0.10),
            "diffRemovedDimmed": blend(p["red"], bg, 0.10),
            "diffAddedWord": blend(p["green"], bg, 0.28),
            "diffRemovedWord": blend(p["red"], bg, 0.28),
            "userMessageBackground": s0,
            "userMessageBackgroundHover": s1,
            "bashMessageBackgroundColor": s0,
            "memoryBackgroundColor": s0,
            "selectionBg": s2,
            "rate_limit_fill": p["blue"],
            "rate_limit_empty": p["surface1"],
            "briefLabelYou": p["blue"],
            "briefLabelClaude": p["peach"],
            "red_FOR_SUBAGENTS_ONLY": p["red"],
            "blue_FOR_SUBAGENTS_ONLY": p["blue"],
            "green_FOR_SUBAGENTS_ONLY": p["green"],
            "yellow_FOR_SUBAGENTS_ONLY": p["yellow"],
            "purple_FOR_SUBAGENTS_ONLY": p["mauve"],
            "orange_FOR_SUBAGENTS_ONLY": p["peach"],
            "pink_FOR_SUBAGENTS_ONLY": p["pink"],
            "cyan_FOR_SUBAGENTS_ONLY": p["teal"],
        },
    }


def themes_for(dark):
    if dark:
        return {
            TERMINAL_SLUG: claude_theme("Catppuccin", "frappe"),
            NVIM_SLUG: claude_theme("Catppuccin (NeoVim)", "frappe", NVIM_FLOAT_BG_DARK, True),
        }
    return {
        TERMINAL_SLUG: claude_theme("Catppuccin", "latte"),
        # NeoVim's light float uses NormalFloat (Latte mantle, one step below base); the base
        # blend is close enough there.
        NVIM_SLUG: claude_theme("Catppuccin (NeoVim)", "latte"),
    }


def claude_config_dirs():
    """~/.claude always (also before Claude Code's first start), other ~/.claude* dirs once they
    hold a settings.json."""
    dirs = {d.resolve() for d in HOME.glob(".claude*") if (d / "settings.json").is_file()}
    dirs.add((HOME / ".claude").resolve())
    return sorted(dirs)


def write_if_changed(path, text):
    """Write-then-rename, so Claude's watcher never reads a half-written file.

    A symlinked file (e.g. a stowed settings.json) is written at its target, keeping the link and
    the file mode.
    """
    path = path.resolve()
    try:
        if path.read_text() == text:
            return False
        mode = path.stat().st_mode & 0o777
    except FileNotFoundError:
        mode = None
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(text)
    if mode is not None:
        os.chmod(tmp, mode)
    os.replace(tmp, path)
    return True


def select_claude_theme(config_dir):
    """Keep the user settings on the terminal theme; NeoVim overrides it per launch."""
    path = config_dir / "settings.json"
    if not path.is_file():
        return
    try:
        settings = json.loads(path.read_text())
    except (OSError, ValueError) as error:
        log(f"skipped {path}: {error}")
        return
    if not isinstance(settings, dict):
        log(f"skipped {path}: not a JSON object")
        return
    if settings.get("theme") == CLAUDE_THEME:
        return
    settings["theme"] = CLAUDE_THEME
    write_if_changed(path, json.dumps(settings, indent=2, ensure_ascii=False) + "\n")


def apply(dark):
    texts = {slug: json.dumps(theme, indent=2) + "\n" for slug, theme in themes_for(dark).items()}
    for config_dir in claude_config_dirs():
        try:
            select_claude_theme(config_dir)
            for slug, text in texts.items():
                write_if_changed(config_dir / "themes" / f"{slug}.json", text)
        except OSError as error:
            log(f"skipped {config_dir}: {error}")
    log(f"applied {'Frappé (dark)' if dark else 'Latte (light)'}")


# --- Linux: XDG desktop portal ------------------------------------------------------------

PORTAL = ["--session", "--dest", "org.freedesktop.portal.Desktop",
          "--object-path", "/org/freedesktop/portal/desktop"]


def portal_scheme_is_dark(text):
    """color-scheme: 1 = prefer dark, 2 = prefer light, 0 = no preference (GNOME: light)."""
    match = re.search(r"uint32 (\d+)", text)
    if not match:
        raise RuntimeError(f"unexpected portal reply: {text.strip()}")
    return match.group(1) == "1"


def linux_is_dark():
    reply = subprocess.run(
        ["gdbus", "call", *PORTAL, "--method", "org.freedesktop.portal.Settings.ReadOne",
         "org.freedesktop.appearance", "color-scheme"],
        capture_output=True, text=True, check=True).stdout
    return portal_scheme_is_dark(reply)


def linux_watch():
    monitor = subprocess.Popen(["gdbus", "monitor", *PORTAL], stdout=subprocess.PIPE, text=True)
    for line in monitor.stdout:
        if " is owned by " in line:
            # gdbus prints this once it listens and whenever the portal (re)appears: read the
            # current state then, so no switch falls in between.
            apply(linux_is_dark())
        elif "SettingChanged" in line and "'org.freedesktop.appearance', 'color-scheme'" in line:
            apply(portal_scheme_is_dark(line.split("'color-scheme'", 1)[1]))
    # Only losing the session bus ends the monitor; the service manager restarts us.
    raise SystemExit(f"portal monitor ended with status {monitor.wait()}")


# --- macOS: appearance setting ------------------------------------------------------------

def mac_is_dark():
    reply = subprocess.run(["defaults", "read", "-g", "AppleInterfaceStyle"],
                           capture_output=True, text=True)
    return reply.stdout.strip() == "Dark"


def mac_watch():
    dark = mac_is_dark()
    apply(dark)
    while True:
        time.sleep(MAC_POLL_SECONDS)
        now = mac_is_dark()
        if now != dark:
            dark = now
            apply(dark)


# --- GNOME Console livery -----------------------------------------------------------------

def console_settings():
    try:
        import gi
        gi.require_version("Gio", "2.0")
        from gi.repository import Gio, GLib
    except (ImportError, ValueError):
        log("PyGObject not found, skipped the GNOME Console livery")
        return None
    source = Gio.SettingsSchemaSource.get_default()
    if source is None or source.lookup("org.gnome.Console", True) is None:
        log("GNOME Console not installed, skipped its livery")
        return None
    return Gio, GLib, Gio.Settings.new("org.gnome.Console")


def livery_palette(GLib, flavour, transparency):
    p = PALETTES[flavour]

    def rgb(name):
        return tuple(c / 255 for c in hex_to_rgb(p[name]))

    return GLib.Variant("a{sv}", {
        "foreground": GLib.Variant("(ddd)", rgb("text")),
        "background": GLib.Variant("(ddd)", rgb("base")),
        "colours": GLib.Variant("a(ddd)", [rgb(name) for name in ANSI[flavour]]),
        "transparency": GLib.Variant("d", transparency),
    })


def other_liveries(settings):
    """Every custom livery except ours, as uuid -> unboxed value."""
    current = settings.get_value("custom-liveries")
    others = {}
    for i in range(current.n_children()):
        entry = current.get_child_value(i)
        uuid = entry.get_child_value(0).get_string()
        if uuid != LIVERY_UUID:
            others[uuid] = entry.get_child_value(1).get_variant()
    return others


def install_console_livery():
    """GNOME Console reads custom liveries from 51.0 on; 50.0 fails to parse them and keeps its
    default colors."""
    found = console_settings()
    if found is None:
        return
    Gio, GLib, settings = found
    liveries = other_liveries(settings)
    # Transparency as in Console's own livery: a hint by night, barely by day.
    liveries[LIVERY_UUID] = GLib.Variant("a{sv}", {
        "uuid": GLib.Variant("s", LIVERY_UUID),
        "name": GLib.Variant("s", LIVERY_NAME),
        "night": livery_palette(GLib, "frappe", 0.04),
        "day": livery_palette(GLib, "latte", 0.01),
    })
    settings.set_value("custom-liveries", GLib.Variant("a{sv}", liveries))
    settings.set_string("livery", LIVERY_UUID)
    Gio.Settings.sync()
    log("GNOME Console livery installed and selected")


def uninstall_console_livery():
    found = console_settings()
    if found is None:
        return
    Gio, GLib, settings = found
    if settings.get_string("livery") == LIVERY_UUID:
        settings.reset("livery")
    settings.set_value("custom-liveries", GLib.Variant("a{sv}", other_liveries(settings)))
    Gio.Settings.sync()
    log("GNOME Console livery removed")


# --- Service setup ------------------------------------------------------------------------

def script_path():
    """The stowed link if it points at this script: it keeps working if the checkout moves."""
    me = Path(sys.argv[0]).resolve()
    stowed = HOME / ".local/bin" / SERVICE_NAME
    return stowed if stowed.resolve() == me else me


def systemd_unit_path():
    return HOME / ".config/systemd/user" / f"{SERVICE_NAME}.service"


def launchd_plist_path():
    return HOME / "Library/LaunchAgents" / f"{LAUNCHD_LABEL}.plist"


def mac_log_path():
    return HOME / "Library/Logs" / f"{SERVICE_NAME}.log"


def install_linux():
    install_console_livery()
    unit = f"""[Unit]
Description=Catppuccin light/dark sync for Claude Code
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart={script_path()} watch
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
"""
    write_if_changed(systemd_unit_path(), unit)
    subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
    subprocess.run(["systemctl", "--user", "enable", f"{SERVICE_NAME}.service"], check=True)
    subprocess.run(["systemctl", "--user", "restart", f"{SERVICE_NAME}.service"], check=True)
    log(f"systemd user service {SERVICE_NAME} enabled and started")


def uninstall_linux():
    subprocess.run(["systemctl", "--user", "disable", "--now", f"{SERVICE_NAME}.service"])
    systemd_unit_path().unlink(missing_ok=True)
    subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
    uninstall_console_livery()


def install_mac():
    plist = f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>{LAUNCHD_LABEL}</string>
  <key>ProgramArguments</key>
  <array><string>{script_path()}</string><string>watch</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>{mac_log_path()}</string>
</dict>
</plist>
"""
    path = launchd_plist_path()
    write_if_changed(path, plist)
    domain = f"gui/{os.getuid()}"
    subprocess.run(["launchctl", "bootout", f"{domain}/{LAUNCHD_LABEL}"], capture_output=True)
    # launchd may still be tearing the old job down; bootstrap fails until it is gone.
    for attempt in range(10):
        if subprocess.run(["launchctl", "bootstrap", domain, str(path)]).returncode == 0:
            break
        time.sleep(0.5)
    else:
        sys.exit(f"launchctl bootstrap {path} failed")
    log(f"launchd agent {LAUNCHD_LABEL} loaded")


def uninstall_mac():
    subprocess.run(["launchctl", "bootout", f"gui/{os.getuid()}/{LAUNCHD_LABEL}"],
                   capture_output=True)
    launchd_plist_path().unlink(missing_ok=True)
    log(f"launchd agent {LAUNCHD_LABEL} removed")


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else "watch"
    mac = sys.platform == "darwin"
    if command == "watch":
        mac_watch() if mac else linux_watch()
    elif command == "apply":
        apply(mac_is_dark() if mac else linux_is_dark())
    elif command == "install":
        install_mac() if mac else install_linux()
    elif command == "uninstall":
        uninstall_mac() if mac else uninstall_linux()
    elif command in ("-h", "--help", "help"):
        print(__doc__)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
